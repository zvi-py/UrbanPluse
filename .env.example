# UrbanPulse environment configuration

# Student Community Agent
PROJECT_NAME=UrbanPulse Student Community Agent
VERSION=0.1.0
API_V1_STR=/api/v1
DATABASE_URL=sqlite:///./urbanpulse.db

# Weather data
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Air quality data
OPENAQ_API_KEY=your_openaq_api_key_here

# Traffic data
TRAFFIC_API_KEY=your_traffic_api_key_here

# Backend URL for React frontend
VITE_API_BASE_URL=http://localhost:8000

# Copy this file to .env and fill in real values.
# Never commit your actual .env file.
